          "request": {
            "name": "Programming Quotes Issue Auth Token",
            "description": {
              "content": "Exchange email and password credentials for a JWT bearer token used to\nauthenticate write endpoints (create / update / delete / vote / favorite).\nIf the email is not registered, a new user is created.\n",
              "type": "text/plain"
            },
            "url": {
